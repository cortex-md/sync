# Self-host: same keys; adjust DEPLOYMENT, PROXY, PROTECTION and MAIL_DRIVER.

CORTEX_SERVER_ENV=production
CORTEX_SERVER_PORT=10000
CORTEX_SERVER_PUBLIC_URL=https://<your-service>.onrender.com

# single: one instance, in-memory bus, migrations on boot | cluster: N replicas through Postgres
CORTEX_DEPLOYMENT=single
# none | render | cloudflare | hops:N — where the real client IP comes from
CORTEX_PROXY=render
# off | standard | strict — rate limits, upload and connection limits
CORTEX_PROTECTION=standard

# Neon: DIRECT connection string (without "-pooler") with sslmode=require.
CORTEX_DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# Generate with: openssl rand -hex 32
CORTEX_AUTH_ACCESS_TOKEN_SECRET=
# open | first-user | closed
CORTEX_AUTH_REGISTRATION_MODE=open

# Cloudflare R2: create the bucket first and an Object Read & Write token scoped to it.
CORTEX_STORAGE_BACKEND=r2
CORTEX_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CORTEX_STORAGE_ACCESS_KEY=
CORTEX_STORAGE_SECRET_KEY=
CORTEX_STORAGE_BUCKET=cortex

# single: no quotas | multi: per-vault quota, per-account caps, vault owner is billed
CORTEX_TENANCY_MODE=multi
CORTEX_TENANCY_DEFAULT_VAULT_QUOTA=1GiB
# everyone | admins
CORTEX_VAULT_CREATION=everyone

# Optional features: collab, avatars, guests, public_links, metrics
CORTEX_FEATURES=collab,avatars,guests,public_links

# none | log | smtp | resend — "none" turns off email verification, password reset and email invites
CORTEX_MAIL_DRIVER=resend
CORTEX_MAIL_RESEND_API_KEY=
CORTEX_MAIL_FROM=Cortex <no-reply@cortex-md.tech>
# smtp only:
# CORTEX_MAIL_HOST=
# CORTEX_MAIL_PORT=587
# CORTEX_MAIL_USERNAME=
# CORTEX_MAIL_PASSWORD=

# Browser origins allowed by CORS (desktop, mobile and web server functions do not need it).
CORTEX_CORS_ALLOWED_ORIGINS=https://cortex-md.tech

# Subscription billed through Stripe. Webhook: https://<host>/webhooks/stripe
CORTEX_SUBSCRIPTION_ENABLED=false
CORTEX_SUBSCRIPTION_STRIPE_SECRET_KEY=
CORTEX_SUBSCRIPTION_STRIPE_PRICE_ID=
CORTEX_SUBSCRIPTION_STRIPE_WEBHOOK_SECRET=

# Optional: sign up, payment and error alerts on Discord.
CORTEX_DEVOPS_DISCORD_WEBHOOK_URL=
