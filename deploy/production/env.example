# Copy to deploy/production/.env on the server and fill in every empty value.

# Public domain served by Caddy (TLS is issued automatically by Let's Encrypt).
CORTEX_SYNC_DOMAIN=api.cortex-md.tech
# Image tag deployed by scripts/deploy.sh: the release version without the "v" (git tag v0.1.0 → 0.1.0).
CORTEX_SYNC_VERSION=0.1.0
# 1 runs a single sync container. 2 adds sync-2 for rolling deploys without downtime.
CORTEX_SYNC_REPLICAS=1
# Upstreams Caddy balances between. Use "sync-1:8080 sync-2:8080" with two replicas.
CORTEX_SYNC_UPSTREAMS=sync-1:8080

# Database (Postgres runs in the same compose project). Use the same password in both lines.
POSTGRES_PASSWORD=
CORTEX_DATABASE_URL=postgres://cortex:<POSTGRES_PASSWORD>@postgres:5432/cortex_sync?sslmode=disable
CORTEX_DATABASE_MAX_CONNS=10
CORTEX_DATABASE_MIN_CONNS=1

# Auth. Generate the secret with: openssl rand -hex 32
CORTEX_AUTH_ACCESS_TOKEN_SECRET=
# open: anyone can sign up · first-user: only the first account · closed: no sign ups
CORTEX_AUTH_REGISTRATION_MODE=open

# File storage on Cloudflare R2. Create the bucket first and an R2 API token
# with Object Read & Write limited to it.
CORTEX_STORAGE_BACKEND=r2
CORTEX_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CORTEX_STORAGE_REGION=auto
CORTEX_STORAGE_ACCESS_KEY=
CORTEX_STORAGE_SECRET_KEY=
CORTEX_STORAGE_BUCKET=cortex-snapshots

# Daily Postgres backups uploaded by scripts/backup-postgres.sh.
# Leave CORTEX_BACKUP_BUCKET empty to keep backups only on the server.
# Endpoint and keys fall back to the storage values above when empty.
CORTEX_BACKUP_BUCKET=cortex-backups
CORTEX_BACKUP_ENDPOINT=
CORTEX_BACKUP_ACCESS_KEY=
CORTEX_BACKUP_SECRET_KEY=
CORTEX_BACKUP_KEEP_LOCAL=3

# Workspace behaviour.
CORTEX_TENANCY_MODE=single
CORTEX_VAULT_CREATION=everyone
CORTEX_FEATURE_COLLAB=true
CORTEX_FEATURE_AVATARS=true
CORTEX_FEATURE_GUESTS=true
CORTEX_FEATURE_PUBLIC_LINKS=true
# auto turns these on when mail is configured.
CORTEX_FEATURE_EMAIL_VERIFICATION=auto
CORTEX_FEATURE_PASSWORD_RESET=auto
CORTEX_METRICS_ENABLED=false

# Mail through Gmail SMTP: turn on 2-Step Verification on the Google account,
# create an App Password and paste its 16 characters below. Gmail sends from
# the account address, up to about 500 messages a day.
CORTEX_MAIL_DRIVER=smtp
CORTEX_MAIL_HOST=smtp.gmail.com
CORTEX_MAIL_PORT=587
CORTEX_MAIL_TLS_MODE=starttls
CORTEX_MAIL_USERNAME=
CORTEX_MAIL_PASSWORD=
CORTEX_MAIL_FROM=Cortex <your-account@gmail.com>

# Cortex Sync plan billed through Stripe.
CORTEX_SUBSCRIPTION_ENABLED=true
CORTEX_SUBSCRIPTION_STRIPE_SECRET_KEY=
CORTEX_SUBSCRIPTION_STRIPE_PRICE_ID=
# Signing secret of the webhook endpoint https://<CORTEX_SYNC_DOMAIN>/webhooks/stripe
CORTEX_SUBSCRIPTION_STRIPE_WEBHOOK_SECRET=
CORTEX_SUBSCRIPTION_CACHE_TTL=60s
CORTEX_SUBSCRIPTION_RENEWAL_GRACE=48h

# Optional alerts for sign ups, payments and errors.
CORTEX_DEVOPS_DISCORD_WEBHOOK_URL=
CORTEX_DEVOPS_DISCORD_USERNAME=Cortex DevOps
